# Optional local-development overrides.
# Auto-login works without this file; these values only replace the defaults.
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=

# Where "לרכישה צרו קשר" leads: mailto:sales@... or https://wa.me/972...
# Empty = the button is hidden and a plain sentence is shown instead.
NEXT_PUBLIC_SALES_CONTACT_URL=

# Optional backend origin used by Next.js server-side requests and API proxying.
API_ORIGIN=http://127.0.0.1:8000

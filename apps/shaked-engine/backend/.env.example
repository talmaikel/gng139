# --- Database ---
# Required: set local or managed-database connection values before startup.
DATABASE_URL=
# Sync URL used by Alembic and by Procrastinate's psycopg connector
DATABASE_URL_SYNC=

# --- Auth ---
# Required: generate a unique secret for each environment.
JWT_SECRET=
JWT_LIFETIME_SECONDS=3600

# --- OpenAI fallback extraction (optional, only used when local OCR confidence is low) ---
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Tesseract ---
# Linux/macOS: /usr/bin/tesseract (or wherever `which tesseract` points).
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=heb+eng

# --- On-demand comparable sales (GovMap) ---
MARKET_DATA_RADIUS_M=500
MARKET_DATA_LOOKBACK_MONTHS=12
MARKET_DATA_CACHE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

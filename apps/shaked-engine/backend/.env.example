# --- Database ---
DATABASE_URL=postgresql+asyncpg://shaked:shaked@localhost:5432/shaked_engine
# Sync URL used by Alembic and by Procrastinate's psycopg connector
DATABASE_URL_SYNC=postgresql://shaked:shaked@localhost:5432/shaked_engine

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_LIFETIME_SECONDS=3600

# --- OpenAI fallback extraction (optional, only used when local OCR confidence is low) ---
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Tesseract ---
# Linux/macOS: /usr/bin/tesseract (or wherever `which tesseract` points).
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=heb+eng

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

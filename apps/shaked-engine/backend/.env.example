# --- Database ---
# Required: set local or managed-database connection values before startup.
DATABASE_URL=
# Sync URL used by Alembic and by Procrastinate's psycopg connector
DATABASE_URL_SYNC=

# --- Auth ---
# Required: generate a unique secret for each environment.
JWT_SECRET=
JWT_LIFETIME_SECONDS=3600

# --- Email: password reset + address verification (Resend) ---
# Empty key = emails are written to the server log instead of sent.
# The sending domain must be verified in Resend (DNS records on gng139.online).
RESEND_API_KEY=
EMAIL_FROM=שקדן <no-reply@gng139.online>
# Where the links inside emails point. In deployment: the public site URL.
FRONTEND_URL=http://localhost:3000

# --- Rate limiting ---
# Header carrying the visitor's real IP, set by the proxy in front of the site
# (cf-connecting-ip behind Cloudflare, x-real-ip behind nginx). Only a header
# that proxy overwrites — never X-Forwarded-For, which Next passes through as
# the browser sent it. Empty = per-IP limits are off; per-account limits stay.
TRUSTED_IP_HEADER=

# --- Mock payments ---
# true = the payment buttons add credits on click, with no charge. Local and
# demos only; keep false in production (admins may still buy instantly).
PAYMENTS_MOCK=false

# --- OpenAI fallback extraction (optional, only used when local OCR confidence is low) ---
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Automated renewal search (Brave Search API), W5 ---
# Without a key, every new renewal check comes back "retryable" — the parcel
# is not scanned as clean, and is not delivered, until a key is set.
BRAVE_SEARCH_API_KEY=

# --- Tesseract ---
# Linux/macOS: /usr/bin/tesseract (or wherever `which tesseract` points).
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=heb+eng

# --- On-demand comparable sales (GovMap) ---
MARKET_DATA_RADIUS_M=500
MARKET_DATA_LOOKBACK_MONTHS=12
MARKET_DATA_CACHE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
